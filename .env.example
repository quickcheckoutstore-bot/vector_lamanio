# Docker Compose reads .env automatically. All settings are optional.
BIND_ADDRESS=127.0.0.1
PORT=8000
MAX_UPLOAD_MB=256
MAX_IMAGE_PIXELS=100000000
MAX_TRACE_DIMENSION=4096
MAX_NATIVE_PIXELS=16000000
MAX_PENDING_JOBS=8
JOB_TIMEOUT_SECONDS=600
RETENTION_HOURS=24
MAX_SVG_PATHS=20000
MAX_SVG_MB=24
WEB_MEMORY=512m
WEB_CPUS=0.5
WORKER_MEMORY=2g
WORKER_CPUS=1.0
COOKIE_SECURE=false
